{
  "name": "quervo-produccion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "local": "tsx src/db/migrar.ts && tsx src/db/seed.ts --demo && next dev",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrar": "tsx src/db/migrar.ts",
    "db:generar": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx --test src/lib/reglas.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
