# Conexión a Postgres (local o Neon). En Vercel se configura en Settings › Environment Variables.
DATABASE_URL=postgresql://quervo:quervo@localhost:5432/quervo_dev

# Auth.js
AUTH_SECRET=genera-uno-con-npx-auth-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Solo desarrollo: permite entrar eligiendo una persona, sin Google. Nunca activar en producción.
DEV_LOGIN=1

# Dirección pública (para enlaces de calendario)
APP_URL=http://localhost:3000
